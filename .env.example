# Native client build settings. No sessions or provider private credentials.
# Optional: absolute path to Firebase Android CLIENT google-services.json.
# Package must match software.technowide.itsaplan.mobile.
GOOGLE_SERVICES_FILE=
# Match the provisioning profile and gateway APNS_ENVIRONMENT.
# Development-signed device: development. TestFlight/App Store: production.
MOBILE_APNS_ENVIRONMENT=development
