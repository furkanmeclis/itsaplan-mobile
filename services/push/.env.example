# Set through the deployment secret store. No working credentials belong here.
# API + worker: upstream checkout and normal upstream runtime configuration
UPSTREAM_ROOT=
DATABASE_URL=
API_URL=
APP_URL=
# API only: independent random 32-byte key encoded as base64
MOBILE_ENCRYPTION_KEY=
# API + worker: HTTPS gateway and this self-host installation's tenant key
MOBILE_GATEWAY_URL=
MOBILE_GATEWAY_KEY=
# Gateway API + gateway worker (separate host/database/key)
GATEWAY_DATABASE_URL=
GATEWAY_ENCRYPTION_KEY=
PORT=8080
# Gateway worker only: mount private provider files read-only
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=software.technowide.itsaplan.mobile
APNS_ENVIRONMENT=development
FCM_SERVICE_ACCOUNT_FILE=
# Native Android build only; Firebase client config, not service-account key
GOOGLE_SERVICES_FILE=
